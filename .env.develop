# For deployment to https://opensquare-dev.nyupress.org/search/

# ensuring react builds in a production mode, since this is still a deployed lower stage environment
# added sourcemaps in the vite config to ensure error traceability in deployed development environment
NODE_ENV=production

# proxy URL for development
# VITE_SOLR_URL=/solr/open-square-metadata-v1/select?
# using full URL for now until we can setup proxying in cloudfront
# VITE_SOLR_URL=http://discovery-solr9-dev-alb-1179707286.us-east-1.elb.amazonaws.com:8983/solr/open-square-metadata-v1/select?
# VITE_SOLR_URL=https://stagediscovery.dlib.nyu.edu/solr/open-square-metadata-v1/select?
# VITE_SOLR_URL=/solr/open-square-metadata-v1/select?
# I have a suspicion that the solr endpoint redirects only under the /search/solr
# VITE_SOLR_URL=/search/solr/open-square-metadata-v1/select?
VITE_SOLR_URL=/solr/open-square-metadata-v1/select?

# solr9 test environment
# no target needed in develop environment since this is client side rendered and the proxy only works in development vite
VITE_SOLR_TARGET=http://discovery-solr9-dev-alb-1179707286.us-east-1.elb.amazonaws.com:8983

VITE_OPEN_SQUARE_ROOT=https://opensquare-dev.nyupress.org

# no analytics in development

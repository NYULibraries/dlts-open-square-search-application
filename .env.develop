# For deployment to https://opensquare-dev.nyupress.org/search/

# ensuring react builds in a production mode
# added sourcemaps ensure error traceability in deployed development environment
NODE_ENV=production

# Application Root
VITE_OPEN_SQUARE_ROOT=https://opensquare-dev.nyupress.org

# Solr9 Proxy and Target Configuration
VITE_SOLR_URL=/solr/open-square-metadata-v1/select?
VITE_SOLR_TARGET=http://discovery-solr9-dev-alb-1179707286.us-east-1.elb.amazonaws.com:8983

# no analytics in develop

# For local development work, for development environment deployment look into .env.develop
# For local development overrides (or secrets) to this file use `.env.development.local`

# Tell react to build a production build of the application

# variables to point at the Viewer API (by Alberto) that points to Solr
# API parses data and formats the data better for rendering
# pointing at stage environment since this API is not deployed on development yet
# VITE_VIEWER_API_PROTOCOL=https
# VITE_VIEWER_API_HOST=stage-sites.dlib.nyu.edu/viewer/api/v1/search?
# VITE_SOLR_CORE_PATH='index=open-square-metadata-v1'

# proxy URL for development
# VITE_SOLR_URL=/search/solr/open-square-metadata-v1/select?
VITE_SOLR_URL=/solr/open-square-metadata-v1/select?

# solr9 environment for vite proxy redirect
VITE_SOLR_TARGET=http://discovery-solr9-dev-alb-1179707286.us-east-1.elb.amazonaws.com:8983

VITE_OPEN_SQUARE_ROOT=https://opensquare-dev.nyupress.org

# no analytics in development

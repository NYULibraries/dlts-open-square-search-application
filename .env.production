# For deployment to https://opensquare.nyupress.org/

# ensuring react builds in a production mode
NODE_ENV=production

# Application Root
VITE_OPEN_SQUARE_ROOT=https://opensquare.nyupress.org

# Solr9 Proxy and Target Configuration
VITE_SOLR_URL=/solr/open-square-metadata-v1/select?
# TODO: update once prod solr9 instace is up
VITE_SOLR_TARGET=http://discovery-solr9-dev-alb-1179707286.us-east-1.elb.amazonaws.com:8983

# Google Analytics
VITE_GOOGLE_ANALYTICS_TRACKING_ID=G-6ZBRSG08EY

# Matomo Analytics
VITE_MATOMO_ANALYTICS_USER=nyulib.matomo.cloud
